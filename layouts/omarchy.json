{
  "id": "root",
  "type": "column",
  "titlebar": "none",
  "traffic_lights": [
    12,
    8
  ],
  "theme": "tokyo-night",
  "terminal_opacity": 0.7,
  "background": {
    "image": "backgrounds/omarchy/tokyo-night/1-winding-road.webp",
    "fit": "cover"
  },
  "terminal_padding": [
    12,
    12
  ],
  "preview": "layouts/omarchy.svg",
  "resizable": false,
  "children": [
    {
      "id": "topbar",
      "type": "row",
      "size": {
        "px": 30
      },
      "window_drag": true,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "bar-left",
          "type": "block",
          "content": {
            "mod": "omarchy-bar",
            "props": {
              "part": "left"
            }
          },
          "size": {
            "weight": 1
          }
        },
        {
          "id": "ai-usage",
          "type": "block",
          "size": {
            "weight": 2
          },
          "content": {
            "mod": "omarchy-ai-usage",
            "props": {
              "compact": true
            }
          }
        },
        {
          "id": "browser-cmd",
          "type": "block",
          "size": {
            "px": 0
          },
          "content": {
            "mod": "omarchy-browser"
          }
        },
        {
          "id": "voice",
          "type": "block",
          "size": {
            "px": 56
          },
          "content": {
            "mod": "omarchy-voice"
          }
        },
        {
          "id": "bar-right",
          "type": "block",
          "size": {
            "weight": 1
          },
          "content": {
            "mod": "omarchy-bar",
            "props": {
              "part": "right"
            }
          }
        }
      ]
    },
    {
      "id": "desk",
      "type": "row",
      "padding": 8,
      "gap": 8,
      "resizable": true,
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "size": {
            "px": 243
          },
          "min": 44,
          "max": 480,
          "resizable": false,
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "omarchy-spaces"
              },
              "background": "chrome",
              "border": {
                "width": 2,
                "color": "border"
              },
              "radius": 12
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "omarchy-agents"
              },
              "background": "chrome",
              "border": {
                "width": 2,
                "color": "border"
              },
              "radius": 12
            },
            {
              "id": "sidebar-footer",
              "type": "block",
              "size": {
                "px": 136
              },
              "content": {
                "mod": "omarchy-chrome",
                "props": {
                  "footer": true
                }
              },
              "background": "chrome",
              "border": {
                "width": 2,
                "color": "border"
              },
              "radius": 12
            }
          ],
          "gap": 8
        },
        {
          "id": "work",
          "type": "column",
          "gap": 8,
          "resizable": false,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "size": {
                "px": 36
              },
              "background": "chrome",
              "border": {
                "width": 2,
                "color": "border"
              },
              "content": {
                "mod": "omarchy-tabs"
              },
              "radius": 12
            },
            {
              "id": "work-body",
              "type": "row",
              "gap": 8,
              "children": [
                {
                  "id": "main",
                  "floating": [
                    {
                      "id": "voice-live",
                      "content": {
                        "mod": "omarchy-voice-live"
                      },
                      "edge": "bottom",
                      "align": "center"
                    }
                  ],
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "omarchy-pane"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "border": {
                        "width": 2,
                        "color": "border"
                      },
                      "focus": {
                        "width": 2,
                        "color": "accent"
                      },
                      "radius": 12,
                      "gap": 8,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "files-plus"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "column",
                          "resizable": false,
                          "children": [
                            {
                              "id": "git-switch",
                              "type": "block",
                              "size": {
                                "px": 42
                              },
                              "content": {
                                "mod": "omarchy-changes",
                                "props": {
                                  "view": "switch"
                                }
                              }
                            },
                            {
                              "id": "git",
                              "type": "stack",
                              "active": "changes-view",
                              "children": [
                                {
                                  "id": "changes-view",
                                  "type": "block",
                                  "content": {
                                    "mod": "omarchy-changes"
                                  }
                                },
                                {
                                  "id": "git-graph",
                                  "type": "block",
                                  "content": {
                                    "mod": "omarchy-changes",
                                    "props": {
                                      "view": "graph"
                                    }
                                  }
                                },
                                {
                                  "id": "review",
                                  "type": "block",
                                  "content": {
                                    "mod": "reviewer",
                                    "props": {
                                      "palette": "theme"
                                    }
                                  }
                                },
                                {
                                  "id": "prs",
                                  "type": "block",
                                  "content": {
                                    "mod": "pr-flow"
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "id": "browser-notes",
                          "type": "block",
                          "content": {
                            "mod": "omarchy-notes"
                          }
                        },
                        {
                          "id": "tasks",
                          "type": "stack",
                          "active": "tasks-list",
                          "children": [
                            {
                              "id": "tasks-list",
                              "type": "block",
                              "content": {
                                "mod": "tasks"
                              }
                            },
                            {
                              "id": "tasks-thread",
                              "type": "column",
                              "resizable": false,
                              "children": [
                                {
                                  "id": "tasks-thread-head",
                                  "type": "block",
                                  "size": {
                                    "px": 127
                                  },
                                  "content": {
                                    "mod": "chat",
                                    "props": {
                                      "panel": true,
                                      "head": true
                                    }
                                  }
                                },
                                {
                                  "id": "tasks-thread-body",
                                  "type": "stack",
                                  "active": "tasks-thread-chat",
                                  "children": [
                                    {
                                      "id": "tasks-thread-chat",
                                      "type": "block",
                                      "content": {
                                        "mod": "chat",
                                        "props": {
                                          "panel": true
                                        }
                                      }
                                    },
                                    {
                                      "id": "tasks-thread-term",
                                      "type": "block",
                                      "content": {
                                        "agent": "focused"
                                      }
                                    },
                                    {
                                      "id": "tasks-thread-files",
                                      "type": "block",
                                      "content": {
                                        "mod": "task-files"
                                      }
                                    },
                                    {
                                      "id": "tasks-thread-changes",
                                      "type": "block",
                                      "content": {
                                        "mod": "task-changes"
                                      }
                                    },
                                    {
                                      "id": "tasks-thread-pr",
                                      "type": "block",
                                      "content": {
                                        "mod": "task-pr"
                                      }
                                    },
                                    {
                                      "id": "tasks-thread-browser",
                                      "type": "column",
                                      "children": [
                                        {
                                          "id": "tasks-thread-browser-host",
                                          "type": "block",
                                          "content": {
                                            "mod": "task-browser"
                                          }
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "id": "artifacts",
                          "type": "stack",
                          "active": "artifacts-list",
                          "children": [
                            {
                              "id": "artifacts-list",
                              "type": "block",
                              "content": {
                                "mod": "artifacts"
                              }
                            },
                            {
                              "id": "artifacts-view",
                              "type": "column",
                              "resizable": false,
                              "children": [
                                {
                                  "id": "artifacts-view-head",
                                  "type": "block",
                                  "size": {
                                    "px": 42
                                  },
                                  "content": {
                                    "mod": "artifacts",
                                    "props": {
                                      "head": true
                                    }
                                  }
                                },
                                {
                                  "id": "artifacts-view-body",
                                  "type": "block",
                                  "content": {
                                    "mod": "artifacts"
                                  }
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "id": "herdr-sim",
                          "type": "block",
                          "content": {
                            "mod": "herdr-sim",
                            "props": {
                              "frames": "panel"
                            }
                          }
                        }
                      ],
                      "active": "changes"
                    }
                  ],
                  "size": {
                    "px": 475
                  },
                  "min": 280,
                  "max": 900,
                  "hidden": true,
                  "background": "chrome",
                  "border": {
                    "width": 2,
                    "color": "border"
                  },
                  "radius": 12
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
