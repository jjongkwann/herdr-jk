+# herdr-artifact on a Windows machine, run by its Python itself (hc exec starts in that machine's home). Not through
+# sh as elsewhere: Git's sh there changes free text on the way (a title's quotes, a note's line breaks, "*", "/x").
+WINDOWS_THERE = ["python3", "-X", "utf8", THERE]
+
+
+def windows(machine):
+    """Whether another machine runs Windows: asked once (its Python's os.name), then kept beside the install marks."""
+    mark = os.path.join(STORE, ".remote", machine + ".os")
+    try:
+        with open(mark) as f:
+            return f.read().strip() == "nt"
+    except OSError:
+        pass
+    r = run(["hc", "exec", "--on", machine, "--", "python3", "-c", "import os; print(os.name)"])
+    kind = r.stdout.strip()
+    if r.returncode != 0 or kind not in ("nt", "posix"):
+        return False
+    with contextlib.suppress(OSError):
+        os.makedirs(os.path.dirname(mark), exist_ok=True)
+        with open(mark, "w") as f:
+            f.write(kind)
+    return kind == "nt"
+
