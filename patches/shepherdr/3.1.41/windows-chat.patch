Subject: Chat on a Windows machine: the Assistant starts there (its one-off template in pieces) and its log is found under Git bash
Owner: shepherdr
Versions: >=3.1.41

diff --git a/core/chat-log.js b/core/chat-log.js
index caf9731..f227779 100644
--- a/core/chat-log.js
+++ b/core/chat-log.js
@@ -15,6 +15,30 @@ export const FIND = `
 kind="$1"; pid="$2"
 procs() { if [ -r /proc/self/stat ]; then cat /proc/[0-9]*/stat 2>/dev/null | awk '{ p = $1; sub(/.*\\) /, ""); print p, $2 }'; else ps -axo pid=,ppid= 2>/dev/null; fi; }
 kids() { procs | sort -n | awk -v r="$1" 'function walk(p,  c, m, j) { m = split(k[p], c, " "); for (j = 1; j <= m; j++) if (!(c[j] in s)) { s[c[j]] = 1; print c[j]; walk(c[j]) } } { k[$2] = k[$2] " " $1 } END { s[r] = 1; walk(r) }'; }
+# Windows (Git's sh: its /proc and ps see only its own programs, not claude.exe): every process under it, from a snapshot. The agent is a child of the
+# Git bash that ran its command there (Windows has no exec), so the terminal's own program is that bash.
+[ -n "\${WINDIR:-}" ] && kids() { python3 -c '
+import ctypes as c, ctypes.wintypes as w, sys
+class E(c.Structure): _fields_ = [("n", w.DWORD), ("u", w.DWORD), ("p", w.DWORD), ("h", c.c_size_t), ("m", w.DWORD), ("t", w.DWORD), ("pp", w.DWORD), ("b", c.c_long), ("f", w.DWORD), ("x", c.c_char * 260)]
+k = c.windll.kernel32
+k.CreateToolhelp32Snapshot.restype = c.c_void_p
+k.Process32First.argtypes = k.Process32Next.argtypes = [c.c_void_p, c.POINTER(E)]
+k.CloseHandle.argtypes = [c.c_void_p]
+s, e, m = k.CreateToolhelp32Snapshot(2, 0), E(), {}
+e.n = c.sizeof(E)
+ok = k.Process32First(s, c.byref(e))
+while ok:
+    m.setdefault(e.pp, []).append(e.p)
+    ok = k.Process32Next(s, c.byref(e))
+k.CloseHandle(s)
+seen = set()
+def d(p):
+    for q in m.get(p, []):
+        if q not in seen:
+            seen.add(q)
+            print(q)
+            d(q)
+d(int(sys.argv[1]))' "$1" 2>/dev/null | tr -d '\\r'; }
 for p in "$pid" $(kids "$pid"); do
   if [ "$kind" = claude ]; then
     j="$HOME/.claude/sessions/$p.json"
