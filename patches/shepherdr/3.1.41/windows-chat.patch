diff --git a/mods/chat/main.js b/mods/chat/main.js
index be1bf5e..98dfeb8 100644
--- a/mods/chat/main.js
+++ b/mods/chat/main.js
@@ -1747,7 +1747,13 @@ export default class Chat extends View {
           words = body.trim();
           oneOff = `herdr-${template}-${Date.now().toString(36)}`;
           const file = `---\nname: ${oneOff}\ndescription: A one-off ${template} start with chosen settings (mods/chat), removed after use.\ncommand: ${cleanCommand(cmd)}\n---\n${body}`;
-          await exec("sh", ["-c", TEMPLATE + 'printf "%s" "$2" > "$dir/$1.md"', "x", oneOff, file], on);
+          // On another machine, in pieces: a command line there can be shorter than the file (Windows: 32,767
+          // characters, and the assistant's words are longer). Each piece goes after a space, dropped there: an
+          // argument with a space is always quoted, so Git's sh on Windows never expands what's in it.
+          const parts = machine ? file.match(/[\s\S]{1,8000}/gu).map((p) => ` ${p}`) : [file];
+          for (const [i, part] of parts.entries()) {
+            await exec("sh", ["-c", TEMPLATE + `printf "%s" "${machine ? "$" + "{2# }" : "$2"}" ${i ? ">>" : ">"} "$dir/$1.md"`, "x", oneOff, part], on);
+          }
           launch = oneOff;
         }
       }
