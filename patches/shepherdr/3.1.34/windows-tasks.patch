+def remote_herdr_task(machine, argv):
+    """The command that runs herdr-task (~/.local/bin/herdr-task) on another machine with these arguments. On Windows
+    it goes to Python itself: Git's sh there mangles arguments (quotes, globs, /paths, line breaks), while a native
