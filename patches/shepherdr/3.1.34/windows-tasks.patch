diff --git a/mods/tasks/bin/herdr_task/compat.py b/mods/tasks/bin/herdr_task/compat.py
new file mode 100644
index 0000000..f030714
--- /dev/null
+++ b/mods/tasks/bin/herdr_task/compat.py
@@ -0,0 +1,94 @@
+"""What herdr-task needs from Unix, on Windows too: file locks (fcntl.flock) and the account's home (pwd).
+
+On macOS and Linux these are the real modules, unchanged. On Windows (a machine linked over herdr-core runs
+herdr-task with native Python), flock takes LockFileEx's shared and exclusive locks, waiting or not as asked,
+and pwd is absent (None): callers fall back to the home Python finds."""
+
+import os
+import subprocess
+import sys
+import time
+
+# A helper started to outlive its caller: a session of its own; on Windows, a process group of its own and no
+# console window (start_new_session means nothing there).
+DETACH = ({"creationflags": subprocess.CREATE_NO_WINDOW | subprocess.CREATE_NEW_PROCESS_GROUP} if os.name == "nt"
+          else {"start_new_session": True})
+
+# herdr-task running itself again: on Windows already in UTF-8 mode, so the entry doesn't start a second Python.
+PY = [sys.executable, "-X", "utf8"] if os.name == "nt" else [sys.executable]
+
+if os.name != "nt":
+    import fcntl  # noqa: F401
+    import pwd  # noqa: F401
+else:
+    import ctypes
+    import ctypes.wintypes as _w
+    import msvcrt
+    import types
+
+    class _Overlapped(ctypes.Structure):
+        _fields_ = [("Internal", ctypes.c_void_p), ("InternalHigh", ctypes.c_void_p), ("Offset", _w.DWORD),
+                    ("OffsetHigh", _w.DWORD), ("hEvent", _w.HANDLE)]
+
+    _k = ctypes.WinDLL("kernel32", use_last_error=True)
+    _k.LockFileEx.argtypes = [_w.HANDLE, _w.DWORD, _w.DWORD, _w.DWORD, _w.DWORD, ctypes.POINTER(_Overlapped)]
+    _k.LockFileEx.restype = _w.BOOL
+    _k.UnlockFileEx.argtypes = [_w.HANDLE, _w.DWORD, _w.DWORD, _w.DWORD, ctypes.POINTER(_Overlapped)]
+    _k.UnlockFileEx.restype = _w.BOOL
+
+    def _flock(f, op):
+        h = msvcrt.get_osfhandle(f if isinstance(f, int) else f.fileno())
+        # One byte far past any data: Windows locks are mandatory, so a lock there never stops a read of the file.
+        ov = _Overlapped(OffsetHigh=0x7FFFFFFF)
+        if op & 8:  # LOCK_UN
+            _k.UnlockFileEx(h, 0, 1, 0, ctypes.byref(ov))
+            return
+        flags = (2 if op & 2 else 0) | (1 if op & 4 else 0)  # LOCKFILE_EXCLUSIVE_LOCK, LOCKFILE_FAIL_IMMEDIATELY
+        if not _k.LockFileEx(h, flags, 0, 1, 0, ctypes.byref(ov)):
+            err = ctypes.get_last_error()
+            if err == 33:  # ERROR_LOCK_VIOLATION: held by another
+                raise BlockingIOError(11, "Resource temporarily unavailable")
+            raise ctypes.WinError(err)
+
+    fcntl = types.SimpleNamespace(LOCK_SH=1, LOCK_EX=2, LOCK_NB=4, LOCK_UN=8, flock=_flock)
+    pwd = None
+
+    # Replacing a file another process has open (an unlocked reader, for a moment) fails on Windows: every
+    # os.replace in herdr-task tries again for up to a second there.
+    _replace = os.replace
+
+    def _replace_again(src, dst, **kw):
+        for _ in range(20):
+            try:
+                return _replace(src, dst, **kw)
+            except PermissionError:
+                time.sleep(0.05)
+        return _replace(src, dst, **kw)
+    os.replace = _replace_again
+
+    class _Entry(ctypes.Structure):
+        _fields_ = [("dwSize", _w.DWORD), ("cntUsage", _w.DWORD), ("th32ProcessID", _w.DWORD), ("th32DefaultHeapID", ctypes.c_size_t),
+                    ("th32ModuleID", _w.DWORD), ("cntThreads", _w.DWORD), ("th32ParentProcessID", _w.DWORD),
+                    ("pcPriClassBase", ctypes.c_long), ("dwFlags", _w.DWORD), ("szExeFile", ctypes.c_char * 260)]
+
+    _k.CreateToolhelp32Snapshot.restype = ctypes.c_void_p
+    _k.Process32First.argtypes = _k.Process32Next.argtypes = [ctypes.c_void_p, ctypes.POINTER(_Entry)]
+    _k.CloseHandle.argtypes = [ctypes.c_void_p]
+
+    def descendants(pid):
+        """Windows: every process under pid: [(pid, exe name, parent pid)] (no pgrep, no ps there)."""
+        s, e, kids = _k.CreateToolhelp32Snapshot(2, 0), _Entry(), {}  # TH32CS_SNAPPROCESS
+        e.dwSize = ctypes.sizeof(_Entry)
+        ok = _k.Process32First(s, ctypes.byref(e))
+        while ok:
+            kids.setdefault(e.th32ParentProcessID, []).append((e.th32ProcessID, e.szExeFile.decode(errors="replace"), e.th32ParentProcessID))
+            ok = _k.Process32Next(s, ctypes.byref(e))
+        _k.CloseHandle(s)
+        out, seen, todo = [], {int(pid)}, [int(pid)]
+        while todo:
+            for c in kids.get(todo.pop(), []):
+                if c[0] not in seen:
+                    seen.add(c[0])
+                    out.append(c)
+                    todo.append(c[0])
+        return out
