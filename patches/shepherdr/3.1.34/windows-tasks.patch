+        with open(mark) as f:
+            kind = f.read().strip()
+    except OSError:
+        r = run(["hc", "exec", "--on", machine, "--", "python3", "-c", "import os; print(os.name)"])
+        kind = (r.stdout.split() or [""])[-1] if r.returncode == 0 else ""
+        if kind in ("nt", "posix"):
+            os.makedirs(os.path.dirname(mark), exist_ok=True)
+            with open(mark, "w") as f:
+                f.write(kind)
