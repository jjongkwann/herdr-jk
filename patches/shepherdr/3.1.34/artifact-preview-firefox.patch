Subject: Artifacts: herdr-artifact preview says to open the link in Firefox through firefox-agent, not the task browser
Owner: shepherdr
Versions: >=3.1.34

diff --git a/mods/artifacts/bin/herdr-artifact b/mods/artifacts/bin/herdr-artifact
index 218e2df..d0b9e8f 100755
--- a/mods/artifacts/bin/herdr-artifact
+++ b/mods/artifacts/bin/herdr-artifact
@@ -1990,9 +1990,9 @@ def cmd_preview(o):
         print(json.dumps({"id": o.id, "link": link}))
     else:
         print(link)
-        print("Open it in your task's browser, as the person sees it on a phone and on a desktop:\n"
-              f"  herdr-browser set viewport 390 844 && herdr-browser open '{link}' && herdr-browser screenshot /abs/phone.png\n"
