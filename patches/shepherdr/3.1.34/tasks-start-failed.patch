+# A worker's agent that exits at launch: looked for this long after it started.
+START_FAIL_MS = 10 * 60000
+
+
+def start_failed(s, t, report):
+    """A worker whose agent exited at launch (a flag its CLI refuses, a CLI that isn't there): its
+    terminal is back at the person's shell before the agent reported a status or took a turn. It
+    needs the person as a start that failed, with the error it printed (news: failed), as a start
+    hc refused does (tick_store: "Couldn't start: ..."), not as an agent waiting for a reply."""
+    a = (t.get("agents") or [None])[-1]
+    if not a or a.get("ended") or a.get("start_failed") or t.get("attention") or now() - (a.get("at") or 0) > START_FAIL_MS:
+        return
+    k = hc_json("get", a["address"])
+    # Still its launch's terminal (a core restart gives a bare shell: revive's), at the shell, never at work.
+    if not k or k.get("state") != "live" or len(k.get("argv") or []) < 2 or agent_running(k) or k.get("turn") or status_word(k):
+        return
+    why = exit_words(run(["hc", "read", a["address"], "--lines", "40"]).stdout) or "its agent exited before its first turn"
+    a["start_failed"] = now()
+    t["attention"], t["attention_at"] = f"Couldn't start: {why}", now()
+    s.dirty = True
+    report.setdefault("start_failed", []).append(s.ref(t))
+
+
