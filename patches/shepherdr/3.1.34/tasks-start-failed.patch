+# An agent that exits at launch (a flag its CLI refuses, a CLI that isn't there) leaves why on the
+# screen, above the person's shell prompt (tick.start_failed()).
+EXIT_WORDS = re.compile(r"\b(?:error|unexpected|unknown|invalid|not found|no such|denied|usage|failed|cannot|can't)\b", re.I)
+
+
+def exit_words(screen):
+    """The last line on an agent's screen that reads like an error, at most 120 characters, else None."""
+    lines = [" ".join(x.split()) for x in str(screen or "").split("\n")]
+    found = next((x for x in reversed(lines) if x and EXIT_WORDS.search(x)), None)
+    return fit(found, 120) if found else None
+
+
 def fit(text, n=LINE_MAX):
     """One line of at most n characters, cut at a word ("…" at the end) when longer."""
     text = " ".join(str(text or "").split())
