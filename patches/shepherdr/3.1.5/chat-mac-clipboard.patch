+// macOS (osascript, JavaScript): prints the copied files' paths, one per line, or "image" once
+// the clipboard's image is written as a PNG to argv[0]. Nothing for text.
+const MAC_CLIP = `ObjC.import("AppKit");
+function run(argv) {
+  const pb = $.NSPasteboard.generalPasteboard;
+  const urls = pb.readObjectsForClassesOptions($([$.NSURL]), $({ NSPasteboardURLReadingFileURLsOnlyKey: true }));
+  if (urls.count > 0) return urls.js.map((u) => u.path.js).join("\\n");
+  let data = pb.dataForType($.NSPasteboardTypePNG);
+  if (data.isNil()) {
+    if (!$.NSImage.canInitWithPasteboard(pb)) return "";
+    const img = $.NSImage.alloc.initWithPasteboard(pb);
+    const rep = img.isNil() ? img : $.NSBitmapImageRep.imageRepWithData(img.TIFFRepresentation);
+    if (rep.isNil()) return "";
+    data = rep.representationUsingTypeProperties($.NSBitmapImageFileTypePNG, $());
+  }
+  return !data.isNil() && data.length > 0 && data.writeToFileAtomically(argv[0], true) ? "image" : "";
+}`;
+async function fromMacClipboard() {
+  const dir = `${appHome()}/data/chat-attach`;
+  const name = `pasted-${new Date().toISOString().replace(/[-:]/g, "").replace(/\..*/, "")}.png`;
+  await exec("mkdir", ["-p", dir]);
+  const out = (await exec("osascript", ["-l", "JavaScript", "-e", MAC_CLIP, `${dir}/${name}`]).catch(() => null))?.stdout?.trim() ?? "";
+  if (out === "image") return [{ path: `${dir}/${name}`, name, image: true, temp: true }];
+  return paths(out.split("\n").filter((l) => l.startsWith("/")));
+}
+
 // Dropped or pasted file paths as attachments.
 export const paths = (list) => list.filter(Boolean).map((p) => ({ path: p, name: base(p), image: isImage(p), temp: false }));
 
